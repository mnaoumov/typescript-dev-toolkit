{
  "name": "@mnaoumov/typescript-dev-toolkit",
  "version": "3.7.0",
  "description": "Generic TypeScript project tooling: build, lint, format, spellcheck, test, gate and release scripts.",
  "keywords": [
    "typescript",
    "tooling",
    "eslint",
    "esbuild"
  ],
  "homepage": "https://mnaoumov.dev/typescript-dev-toolkit/",
  "bugs": {
    "url": "https://github.com/mnaoumov/typescript-dev-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/typescript-dev-toolkit.git"
  },
  "license": "MIT",
  "author": "Michael Naumov",
  "type": "module",
  "bin": {
    "sync-upstreams": "bin/sync-upstreams.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/esm/index.d.mts",
        "default": "./dist/lib/esm/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/index.d.cts",
        "default": "./dist/lib/cjs/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/lib/esm/*.d.mts",
        "default": "./dist/lib/esm/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/*.d.cts",
        "default": "./dist/lib/cjs/*.cjs"
      }
    },
    "./bundlers": {
      "import": {
        "types": "./dist/lib/esm/bundlers/index.d.mts",
        "default": "./dist/lib/esm/bundlers/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/bundlers/index.d.cts",
        "default": "./dist/lib/cjs/bundlers/index.cjs"
      }
    },
    "./bundlers/*": {
      "import": {
        "types": "./dist/lib/esm/bundlers/*.d.mts",
        "default": "./dist/lib/esm/bundlers/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/bundlers/*.d.cts",
        "default": "./dist/lib/cjs/bundlers/*.cjs"
      }
    },
    "./bundlers/esbuild-impl": {
      "import": {
        "types": "./dist/lib/esm/bundlers/esbuild-impl/index.d.mts",
        "default": "./dist/lib/esm/bundlers/esbuild-impl/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/bundlers/esbuild-impl/index.d.cts",
        "default": "./dist/lib/cjs/bundlers/esbuild-impl/index.cjs"
      }
    },
    "./bundlers/esbuild-impl/*": {
      "import": {
        "types": "./dist/lib/esm/bundlers/esbuild-impl/*.d.mts",
        "default": "./dist/lib/esm/bundlers/esbuild-impl/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/bundlers/esbuild-impl/*.d.cts",
        "default": "./dist/lib/cjs/bundlers/esbuild-impl/*.cjs"
      }
    },
    "./docs-site": {
      "import": {
        "types": "./dist/lib/esm/docs-site/index.d.mts",
        "default": "./dist/lib/esm/docs-site/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/docs-site/index.d.cts",
        "default": "./dist/lib/cjs/docs-site/index.cjs"
      }
    },
    "./docs-site/*": {
      "import": {
        "types": "./dist/lib/esm/docs-site/*.d.mts",
        "default": "./dist/lib/esm/docs-site/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/docs-site/*.d.cts",
        "default": "./dist/lib/cjs/docs-site/*.cjs"
      }
    },
    "./formatters": {
      "import": {
        "types": "./dist/lib/esm/formatters/index.d.mts",
        "default": "./dist/lib/esm/formatters/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/formatters/index.d.cts",
        "default": "./dist/lib/cjs/formatters/index.cjs"
      }
    },
    "./formatters/*": {
      "import": {
        "types": "./dist/lib/esm/formatters/*.d.mts",
        "default": "./dist/lib/esm/formatters/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/formatters/*.d.cts",
        "default": "./dist/lib/cjs/formatters/*.cjs"
      }
    },
    "./linters": {
      "import": {
        "types": "./dist/lib/esm/linters/index.d.mts",
        "default": "./dist/lib/esm/linters/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/index.d.cts",
        "default": "./dist/lib/cjs/linters/index.cjs"
      }
    },
    "./linters/*": {
      "import": {
        "types": "./dist/lib/esm/linters/*.d.mts",
        "default": "./dist/lib/esm/linters/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/*.d.cts",
        "default": "./dist/lib/cjs/linters/*.cjs"
      }
    },
    "./linters/eslint-rules": {
      "import": {
        "types": "./dist/lib/esm/linters/eslint-rules/index.d.mts",
        "default": "./dist/lib/esm/linters/eslint-rules/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/eslint-rules/index.d.cts",
        "default": "./dist/lib/cjs/linters/eslint-rules/index.cjs"
      }
    },
    "./linters/eslint-rules/*": {
      "import": {
        "types": "./dist/lib/esm/linters/eslint-rules/*.d.mts",
        "default": "./dist/lib/esm/linters/eslint-rules/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/eslint-rules/*.d.cts",
        "default": "./dist/lib/cjs/linters/eslint-rules/*.cjs"
      }
    },
    "./linters/eslint-types/*": {
      "import": {
        "types": "./dist/lib/esm/linters/eslint-types/*.d.mts",
        "default": "./dist/lib/esm/linters/eslint-types/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/eslint-types/*.d.cts",
        "default": "./dist/lib/cjs/linters/eslint-types/*.cjs"
      }
    },
    "./linters/eslint-types/@types/*": {
      "import": {
        "types": "./dist/lib/esm/linters/eslint-types/@types/*.d.mts"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/eslint-types/@types/*.d.cts"
      }
    },
    "./linters/markdownlint-rules": {
      "import": {
        "types": "./dist/lib/esm/linters/markdownlint-rules/index.d.mts",
        "default": "./dist/lib/esm/linters/markdownlint-rules/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/markdownlint-rules/index.d.cts",
        "default": "./dist/lib/cjs/linters/markdownlint-rules/index.cjs"
      }
    },
    "./linters/markdownlint-rules/*": {
      "import": {
        "types": "./dist/lib/esm/linters/markdownlint-rules/*.d.mts",
        "default": "./dist/lib/esm/linters/markdownlint-rules/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/markdownlint-rules/*.d.cts",
        "default": "./dist/lib/cjs/linters/markdownlint-rules/*.cjs"
      }
    },
    "./linters/markdownlint-types/*": {
      "import": {
        "types": "./dist/lib/esm/linters/markdownlint-types/*.d.mts",
        "default": "./dist/lib/esm/linters/markdownlint-types/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/markdownlint-types/*.d.cts",
        "default": "./dist/lib/cjs/linters/markdownlint-types/*.cjs"
      }
    },
    "./linters/markdownlint-types/@types/*": {
      "import": {
        "types": "./dist/lib/esm/linters/markdownlint-types/@types/*.d.mts"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/markdownlint-types/@types/*.d.cts"
      }
    },
    "./test-runners": {
      "import": {
        "types": "./dist/lib/esm/test-runners/index.d.mts",
        "default": "./dist/lib/esm/test-runners/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/test-runners/index.d.cts",
        "default": "./dist/lib/cjs/test-runners/index.cjs"
      }
    },
    "./test-runners/*": {
      "import": {
        "types": "./dist/lib/esm/test-runners/*.d.mts",
        "default": "./dist/lib/esm/test-runners/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/test-runners/*.d.cts",
        "default": "./dist/lib/cjs/test-runners/*.cjs"
      }
    }
  },
  "files": [
    "**/package.json",
    "assets/",
    "bin/",
    "dist/",
    "!dist/*.tgz",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "jiti scripts/build.ts",
    "build:clean": "jiti scripts/build-clean.ts",
    "build:compile": "jiti scripts/build-compile.ts",
    "build:compile:typescript": "jiti scripts/build-compile-typescript.ts",
    "build:generate-exports": "jiti scripts/build-generate-exports.ts",
    "build:generate-index": "jiti scripts/build-generate-index.ts",
    "build:lib": "jiti scripts/build-lib.ts",
    "build:types": "jiti scripts/build-types.ts",
    "build:validate-declarations": "jiti scripts/build-validate-declarations.ts",
    "build:validate-dependencies": "jiti scripts/build-validate-dependencies.ts",
    "commit": "jiti scripts/commit.ts",
    "docs:build": "jiti scripts/docs-build.ts",
    "docs:check-snippets": "jiti scripts/docs-check-snippets.ts",
    "docs:dev": "jiti scripts/docs-dev.ts",
    "docs:preview": "jiti scripts/docs-preview.ts",
    "find-overexposed": "jiti scripts/find-overexposed.ts",
    "find-overexposed:fix": "jiti scripts/find-overexposed-fix.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "gate": "jiti scripts/gate.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "lint:md": "jiti scripts/lint-md.ts",
    "lint:md:fix": "jiti scripts/lint-md-fix.ts",
    "prepare": "jiti scripts/prepare.ts",
    "publish:npm": "jiti scripts/publish-npm.ts",
    "spellcheck": "jiti scripts/spellcheck.ts",
    "test": "jiti scripts/test.ts",
    "test:coverage": "jiti scripts/test-coverage.ts",
    "test:integration": "jiti scripts/test-integration.ts integration-tests",
    "test:watch": "jiti scripts/test-watch.ts",
    "version": "jiti scripts/version.ts"
  },
