    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.2",
    "@mnaoumov/typescript-test-toolkit": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/mdast": "^4.0.4",
